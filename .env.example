# FULL ACCESS means every path reachable by this Windows account is allowed.
PC_MCP_FULL_ACCESS=1

# Use streamable-http for ChatGPT. Use stdio for local MCP hosts such as Codex.
PC_MCP_TRANSPORT=streamable-http
PC_MCP_HOST=127.0.0.1
PC_MCP_PORT=8765

# Generate a long random value. The install script creates one automatically.
# This becomes part of the unguessable MCP URL: /mcp/<secret>
PC_MCP_ENDPOINT_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET

# Used only when PC_MCP_FULL_ACCESS=0. Separate roots with semicolons.
PC_MCP_ALLOWED_ROOTS=%USERPROFILE%\Documents;%USERPROFILE%\Projects

# Limits prevent accidental giant responses/writes. Shell commands can still
# deliberately process large files without loading them into an MCP response.
PC_MCP_MAX_READ_BYTES=2000000
PC_MCP_MAX_WRITE_BYTES=10000000
PC_MCP_MAX_COMMAND_OUTPUT_CHARS=120000
PC_MCP_MAX_COMMAND_TIMEOUT_SECONDS=900

# Keep false. The server should remain on localhost and be reached through a tunnel.
PC_MCP_ALLOW_NETWORK_BIND=0
